{
  "name": "afro-technology/waha-laravel-sdk",
  "description": "Laravel SDK for WAHA with multi-host, optional DB pinning, and OpenAPI generated client",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "waha",
    "whatsapp",
    "laravel",
    "sdk",
    "openapi"
  ],
  "require": {
    "php": "^8.1 || ^8.2 || ^8.3 || ^8.4",
    "guzzlehttp/guzzle": "^7.5",
    "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0"
  },
  "require-dev": {
    "larastan/larastan": "^2.11 || ^3.9",
    "laravel/pint": "^1.29",
    "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
    "phpstan/phpstan": "^1.12 || ^2.1",
    "phpunit/phpunit": "^10.0 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "AfroTechnology\\Waha\\": "src/",
      "AfroTechnology\\Waha\\Generated\\": "src/Generated/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AfroTechnology\\Waha\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "AfroTechnology\\Waha\\WahaServiceProvider"
      ],
      "aliases": {
        "Waha": "AfroTechnology\\Waha\\Facades\\Waha"
      }
    }
  },
  "scripts": {
    "openapi:fetch": "php artisan waha:openapi:fetch",
    "openapi:generate": "php artisan waha:openapi:generate",
    "openapi:update": "php artisan waha:openapi:update",
    "lint": "php bin/php-lint.php",
    "test": "vendor/bin/phpunit",
    "format": "vendor/bin/pint",
    "pint": "@format",
    "pint:test": "vendor/bin/pint --test",
    "stan": "XDEBUG_MODE=off vendor/bin/phpstan analyse",
    "analyse": "@stan",
    "ci:all": [
      "@composer validate --strict --no-check-lock",
      "@lint",
      "@pint:test",
      "@stan",
      "@test"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  }
}
